{
  "_description": "High-branching bracketing scenario for seed convergence analysis. branching_prob_order1=0.80 (near CMA-ES upper bound). Use with analyse_seed_convergence.jl --template to estimate the UPPER BOUND of K needed. NOT a calibrated parameter set.",

  "architecture_type": "dicot_taproot",
  "name": "VirtualDicot_HighBranch",

  "root_axis_classes": {
    "_note": "Documentation metadata only — not read by the simulator.",
    "primary": { "enabled": true, "count": 1, "origin": "radicle", "role": "taproot", "dominance": "high", "emergence_day": 0 },
    "seminal":  { "enabled": false, "count": 0 },
    "nodal":    { "enabled": false, "count": 0 }
  },

  "root_elongation_mode": "logistic",
  "elongation_rate_min": 0.10,
  "elongation_rate_max": 1.20,
  "elongation_logistic_k": 0.25,
  "elongation_logistic_t50": 15.0,

  "n_axial_roots": 1,
  "axial_spread_deg": 3.0,
  "axial_jitter_sd_deg": 1.0,
  "elongation_rate_axial": 0.70,
  "max_tip_age_axial": 120,
  "gravitropism": 0.80,
  "g_axial": 0.10,
  "noise_axial": 0.01,

  "branching_prob_order1": 0.80,
  "branch_angle_order1": 70.0,
  "max_order1_per_plant": 20,
  "elongation_rate_order1": 0.40,
  "max_tip_age_order1": 90,

  "branching_prob_order2": 0.50,
  "branch_angle_order2": 75.0,
  "elongation_rate_order2": 0.02,
  "max_tip_age_order2": 3,
  "order2_start_depth_cm": 1.0,
  "order2_end_depth_cm": 70.0,

  "g_lateral": 0.05,
  "noise_lateral": 0.15,

  "srl_m_per_g": 100.0
}
